//starts from here
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  displayName    String
  bio            String?
  spotifyGenres  String[]
  driftMode      Boolean  @default(false)
  createdAt      DateTime @default(now())
}